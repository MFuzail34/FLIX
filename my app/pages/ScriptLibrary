import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { createPageUrl } from '@/utils';
import { base44 } from '@/api/base44Client';
import { useQuery, useQueryClient } from '@tanstack/react-query';
import { motion } from 'framer-motion';
import { format } from 'date-fns';
import { Film, Trash2, Search, Eye, Download } from 'lucide-react';
import Sidebar from '@/components/layout/Sidebar';
import { Input } from '@/components/ui/input';
import {
  AlertDialog,
  AlertDialogAction,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
} from "@/components/ui/alert-dialog";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
} from "@/components/ui/dialog";
import { Button } from '@/components/ui/button';
import { toast } from 'sonner';

export default function ScriptLibrary() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [deleteId, setDeleteId] = useState(null);
  const [viewScript, setViewScript] = useState(null);

  const { data: conversations = [] } = useQuery({
    queryKey: ['conversations'],
    queryFn: () => base44.entities.Conversation.list('-created_date', 20),
  });

  const { data: scripts = [], isLoading } = useQuery({
    queryKey: ['scripts'],
    queryFn: () => base44.entities.Script.list('-created_date', 100),
  });

  const filteredScripts = scripts.filter(script => 
    script.title?.toLowerCase().includes(searchQuery.toLowerCase()) ||
    script.genre?.toLowerCase().includes(searchQuery.toLowerCase())
  );

  const handleDelete = async () => {
    if (deleteId) {
      await base44.entities.Script.delete(deleteId);
      queryClient.invalidateQueries(['scripts']);
      toast.success('Script deleted');
      setDeleteId(null);
    }
  };

  const handleDownload = (script) => {
    const blob = new Blob([script.content], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${script.title || 'script'}.txt`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast.success('Script downloaded');
  };

  return (
    <div className="min-h-screen bg-[#FAFAF8]">
      <Sidebar 
        conversations={conversations}
        onNewChat={() => navigate(createPageUrl('Home'))}
        isOpen={sidebarOpen}
        onToggle={() => setSidebarOpen(!sidebarOpen)}
        isMobile={true}
      />
      <Sidebar 
        conversations={conversations}
        onNewChat={() => navigate(createPageUrl('Home'))}
        isOpen={true}
        isMobile={false}
      />

      <main className="md:ml-[260px] min-h-screen">
        <div className="max-w-5xl mx-auto px-4 py-8">
          <motion.div
            initial={{ opacity: 0, y: -10 }}
            animate={{ opacity: 1, y: 0 }}
          >
            <h1 className="text-2xl font-semibold text-stone-800 mb-2">Script Library</h1>
            <p className="text-stone-500 mb-6">Your saved scripts</p>

            {/* Search */}
            <div className="relative mb-8">
              <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400" />
              <Input
                type="text"
                placeholder="Search scripts..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="pl-11 bg-white border-stone-200 rounded-xl h-12"
              />
            </div>

            {/* Scripts Grid */}
            {isLoading ? (
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {[1, 2, 3].map((i) => (
                  <div key={i} className="h-48 bg-stone-100 rounded-xl animate-pulse" />
                ))}
              </div>
            ) : filteredScripts.length === 0 ? (
              <div className="text-center py-16">
                <Film className="w-12 h-12 text-stone-300 mx-auto mb-4" />
                <p className="text-stone-500 mb-4">
                  {searchQuery ? 'No scripts found' : 'No scripts yet'}
                </p>
                <button
                  onClick={() => navigate(createPageUrl('ScriptWriter'))}
                  className="text-teal-600 hover:text-teal-700 text-sm font-medium"
                >
                  Create your first script
                </button>
              </div>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {filteredScripts.map((script, index) => (
                  <motion.div
                    key={script.id}
                    initial={{ opacity: 0, y: 10 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: index * 0.05 }}
                    className="group bg-white rounded-xl border border-stone-200 
                             hover:border-stone-300 hover:shadow-md transition-all duration-200 
                             overflow-hidden"
                  >
                    <div className="p-5">
                      <div className="flex items-start justify-between mb-3">
                        <div className="w-10 h-10 rounded-lg bg-gradient-to-br from-teal-400 
                                      to-teal-600 flex items-center justify-center flex-shrink-0">
                          <Film className="w-5 h-5 text-white" />
                        </div>
                        <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                          <button
                            onClick={() => setViewScript(script)}
                            className="p-1.5 rounded-lg hover:bg-stone-100 text-stone-500"
                          >
                            <Eye className="w-4 h-4" />
                          </button>
                          <button
                            onClick={() => handleDownload(script)}
                            className="p-1.5 rounded-lg hover:bg-stone-100 text-stone-500"
                          >
                            <Download className="w-4 h-4" />
                          </button>
                          <button
                            onClick={() => setDeleteId(script.id)}
                            className="p-1.5 rounded-lg hover:bg-red-50 text-red-500"
                          >
                            <Trash2 className="w-4 h-4" />
                          </button>
                        </div>
                      </div>
                      
                      <h3 className="font-semibold text-stone-800 mb-2 line-clamp-2">
                        {script.title}
                      </h3>
                      
                      <div className="flex flex-wrap gap-1.5 mb-3">
                        <span className="px-2 py-0.5 bg-stone-100 text-stone-600 rounded text-xs capitalize">
                          {script.genre}
                        </span>
                        <span className="px-2 py-0.5 bg-stone-100 text-stone-600 rounded text-xs capitalize">
                          {script.format?.replace('_', ' ')}
                        </span>
                        {script.duration && (
                          <span className="px-2 py-0.5 bg-stone-100 text-stone-600 rounded text-xs">
                            {script.duration}
                          </span>
                        )}
                      </div>
                      
                      <p className="text-xs text-stone-500">
                        {format(new Date(script.created_date), 'MMM d, yyyy')}
                      </p>
                    </div>
                  </motion.div>
                ))}
              </div>
            )}
          </motion.div>
        </div>
      </main>

      {/* View Dialog */}
      <Dialog open={!!viewScript} onOpenChange={() => setViewScript(null)}>
        <DialogContent className="max-w-4xl max-h-[80vh] overflow-y-auto">
          <DialogHeader>
            <DialogTitle>{viewScript?.title}</DialogTitle>
          </DialogHeader>
          {viewScript && (
            <div className="space-y-4">
              <div className="flex flex-wrap gap-2">
                <span className="px-2 py-1 bg-stone-100 rounded text-sm capitalize">
                  {viewScript.genre}
                </span>
                <span className="px-2 py-1 bg-stone-100 rounded text-sm capitalize">
                  {viewScript.format?.replace('_', ' ')}
                </span>
                {viewScript.duration && (
                  <span className="px-2 py-1 bg-stone-100 rounded text-sm">
                    {viewScript.duration}
                  </span>
                )}
              </div>
              <pre className="whitespace-pre-wrap font-mono text-xs text-stone-700 
                           bg-stone-50 p-4 rounded-lg">
                {viewScript.content}
              </pre>
              <div className="flex gap-2">
                <Button
                  onClick={() => handleDownload(viewScript)}
                  className="bg-teal-600 hover:bg-teal-700"
                >
                  <Download className="w-4 h-4 mr-2" />
                  Download
                </Button>
                <Button
                  variant="outline"
                  onClick={() => setViewScript(null)}
                >
                  Close
                </Button>
              </div>
            </div>
          )}
        </DialogContent>
      </Dialog>

      {/* Delete Dialog */}
      <AlertDialog open={!!deleteId} onOpenChange={() => setDeleteId(null)}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>Delete script?</AlertDialogTitle>
            <AlertDialogDescription>
              This action cannot be undone. This will permanently delete this script.
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel>Cancel</AlertDialogCancel>
            <AlertDialogAction onClick={handleDelete} className="bg-red-600 hover:bg-red-700">
              Delete
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </div>
  );
}