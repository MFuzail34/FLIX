import React from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Brain, Trash2, X } from 'lucide-react';
import { toast } from 'sonner';

export default function MemoryPanel({ memories, onDelete, onClearAll, onClose }) {
  const handleClearAll = () => {
    if (confirm('Are you sure you want to clear all memories? This cannot be undone.')) {
      onClearAll();
    }
  };

  return (
    <motion.div
      initial={{ opacity: 0, x: 300 }}
      animate={{ opacity: 1, x: 0 }}
      exit={{ opacity: 0, x: 300 }}
      className="fixed right-0 top-0 bottom-0 w-80 bg-white border-l border-stone-200 shadow-xl z-50 overflow-hidden flex flex-col"
    >
      {/* Header */}
      <div className="p-4 border-b border-stone-100 flex items-center justify-between">
        <div className="flex items-center gap-2">
          <Brain className="w-5 h-5 text-teal-600" />
          <h3 className="font-semibold text-stone-800">AI Memory</h3>
        </div>
        <button
          onClick={onClose}
          className="p-1 hover:bg-stone-100 rounded-lg transition-colors"
        >
          <X className="w-5 h-5 text-stone-500" />
        </button>
      </div>

      {/* Memories List */}
      <div className="flex-1 overflow-y-auto p-4">
        {memories.length === 0 ? (
          <div className="text-center py-8 text-stone-400">
            <Brain className="w-12 h-12 mx-auto mb-2 opacity-30" />
            <p className="text-sm">No memories yet</p>
            <p className="text-xs mt-1">
              I'll remember important information as we chat
            </p>
          </div>
        ) : (
          <div className="space-y-3">
            <AnimatePresence>
              {memories.map((memory) => (
                <motion.div
                  key={memory.id}
                  initial={{ opacity: 0, y: -10 }}
                  animate={{ opacity: 1, y: 0 }}
                  exit={{ opacity: 0, x: -50 }}
                  className="bg-stone-50 rounded-lg p-3 group"
                >
                  <div className="flex items-start justify-between gap-2">
                    <div className="flex-1 min-w-0">
                      <div className="text-xs font-medium text-teal-700 mb-1">
                        {memory.key.replace(/_/g, ' ')}
                      </div>
                      <div className="text-sm text-stone-700 break-words">
                        {memory.value}
                      </div>
                    </div>
                    <button
                      onClick={() => onDelete(memory.id)}
                      className="opacity-0 group-hover:opacity-100 p-1 hover:bg-red-50 rounded transition-all"
                      title="Delete this memory"
                    >
                      <Trash2 className="w-4 h-4 text-red-500" />
                    </button>
                  </div>
                </motion.div>
              ))}
            </AnimatePresence>
          </div>
        )}
      </div>

      {/* Footer */}
      {memories.length > 0 && (
        <div className="p-4 border-t border-stone-100">
          <button
            onClick={handleClearAll}
            className="w-full py-2 px-4 bg-red-50 text-red-600 hover:bg-red-100 
                     rounded-lg font-medium text-sm transition-colors flex items-center 
                     justify-center gap-2"
          >
            <Trash2 className="w-4 h-4" />
            Clear All Memories
          </button>
        </div>
      )}
    </motion.div>
  );
}