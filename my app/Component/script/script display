import React, { useState } from 'react';
import { motion } from 'framer-motion';
import { Copy, Download, Save, Check, Edit2 } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Textarea } from '@/components/ui/textarea';
import { toast } from 'sonner';

export default function ScriptDisplay({ script, onSave, isSaving }) {
  const [copied, setCopied] = useState(false);
  const [isEditing, setIsEditing] = useState(false);
  const [editedContent, setEditedContent] = useState(script.content);

  const handleCopy = () => {
    navigator.clipboard.writeText(script.content);
    setCopied(true);
    toast.success('Script copied to clipboard');
    setTimeout(() => setCopied(false), 2000);
  };

  const handleDownload = () => {
    const blob = new Blob([script.content], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${script.title || 'script'}.txt`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast.success('Script downloaded');
  };

  const handleSave = () => {
    onSave({ ...script, content: editedContent });
    setIsEditing(false);
  };

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      className="w-full max-w-4xl mx-auto mt-8"
    >
      {/* Header */}
      <div className="bg-white rounded-t-2xl border border-stone-200 border-b-0 p-6">
        <div className="flex items-start justify-between">
          <div>
            <h2 className="text-2xl font-semibold text-stone-800 mb-2">
              {script.title || 'Untitled Script'}
            </h2>
            <div className="flex flex-wrap gap-2 text-sm text-stone-500">
              <span className="px-2 py-1 bg-stone-100 rounded-md capitalize">
                {script.genre}
              </span>
              <span className="px-2 py-1 bg-stone-100 rounded-md capitalize">
                {script.format?.replace('_', ' ')}
              </span>
              {script.duration && (
                <span className="px-2 py-1 bg-stone-100 rounded-md">
                  {script.duration}
                </span>
              )}
              {script.scenes && (
                <span className="px-2 py-1 bg-stone-100 rounded-md">
                  {script.scenes} scenes
                </span>
              )}
            </div>
          </div>
          <div className="flex gap-2">
            <Button
              variant="outline"
              size="icon"
              onClick={() => setIsEditing(!isEditing)}
              className="rounded-xl border-stone-200"
            >
              <Edit2 className="w-4 h-4" />
            </Button>
            <Button
              variant="outline"
              size="icon"
              onClick={handleCopy}
              className="rounded-xl border-stone-200"
            >
              {copied ? (
                <Check className="w-4 h-4 text-green-600" />
              ) : (
                <Copy className="w-4 h-4" />
              )}
            </Button>
            <Button
              variant="outline"
              size="icon"
              onClick={handleDownload}
              className="rounded-xl border-stone-200"
            >
              <Download className="w-4 h-4" />
            </Button>
            <Button
              onClick={handleSave}
              disabled={isSaving}
              className="bg-teal-600 hover:bg-teal-700 text-white rounded-xl"
            >
              <Save className="w-4 h-4 mr-2" />
              {isSaving ? 'Saving...' : 'Save'}
            </Button>
          </div>
        </div>

        {/* Characters */}
        {script.characters && script.characters.length > 0 && (
          <div className="mt-4 pt-4 border-t border-stone-100">
            <h3 className="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">
              Characters
            </h3>
            <div className="flex flex-wrap gap-2">
              {script.characters.map((character, index) => (
                <span
                  key={index}
                  className="px-3 py-1 bg-teal-50 text-teal-700 rounded-full text-sm"
                >
                  {character}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>

      {/* Content */}
      <div className="bg-white rounded-b-2xl border border-stone-200 p-6">
        {isEditing ? (
          <Textarea
            value={editedContent}
            onChange={(e) => setEditedContent(e.target.value)}
            className="min-h-[600px] font-mono text-sm bg-stone-50 border-stone-200 
                     rounded-xl resize-none"
          />
        ) : (
          <pre className="whitespace-pre-wrap font-mono text-sm text-stone-700 leading-relaxed">
            {script.content}
          </pre>
        )}
      </div>
    </motion.div>
  );
}